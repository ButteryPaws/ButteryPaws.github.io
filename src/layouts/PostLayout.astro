---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  post: any;
  section: 'blog' | 'ctf';
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, section, headings = [] } = Astro.props;
const { data } = post;

const isCtf = section === 'ctf';

// Table of contents, shown for long posts (>= 3 entries) as a sticky sidebar on
// desktop, a collapsible block on mobile. Astro auto-assigns the heading `id`s
// these anchors point to. Posts don't all use the same heading levels (some use
// `#`/`###`, skipping `##`), so we rank the DISTINCT levels actually present and
// indent by that rank; this compresses skipped levels away. Keep the top three.
const usedDepths = [...new Set(headings.map((h) => h.depth))].sort((a, b) => a - b);
const toc = headings
  .map((h) => ({ ...h, level: usedDepths.indexOf(h.depth) }))
  .filter((h) => h.level <= 2);
const showToc = toc.length >= 3;

// CTF problem prompt + hints are authored as Markdown in frontmatter; render
// them to HTML so links, bold, inline code, etc. display properly.
const problemHtml = isCtf && data.problem ? await renderMarkdown(data.problem) : null;
const hintsHtml: string[] =
  isCtf && data.hints.length
    ? await Promise.all(data.hints.map((h: string) => renderMarkdown(h)))
    : [];

// Build prev/next within the same collection, newest-first.
const all = (await getCollection(section, ({ data }: any) => !data.draft)).sort(
  (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf()
);
const idx = all.findIndex((p: any) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout title={data.title} description={data.description} article={true}>
  <article>
    <div class="page-head">
      <div class="page-head__cmd">
        <Prompt path={`~/${section}`} cmd={`cat ${post.id}.md`} />
      </div>
      <h1>{data.title}</h1>
      <p class="post-item__meta" style="margin-top:0.7rem">
        <FormattedDate date={data.date} />
        {data.updated && (
          <span class="muted">· updated <FormattedDate date={data.updated} /></span>
        )}
        {isCtf && data.category && <span class="meta-cat">{data.category}</span>}
      </p>
    </div>

    {
      isCtf && (data.event || data.category || data.difficulty || data.points) && (
        <dl class="challenge-card">
          {data.event && (
            <div><dt>Event</dt><dd>{data.event}</dd></div>
          )}
          {data.category && (
            <div><dt>Category</dt><dd>{data.category}</dd></div>
          )}
          {data.difficulty && (
            <div>
              <dt>Difficulty</dt>
              <dd class={`difficulty--${data.difficulty}`}>{data.difficulty}</dd>
            </div>
          )}
          {typeof data.points === 'number' && (
            <div><dt>Points</dt><dd>{data.points}</dd></div>
          )}
        </dl>
      )
    }

    {
      isCtf && (data.problem || data.problemUrl || data.hints.length > 0) && (
        <section class="problem" aria-label="Challenge problem">
          <h2 class="problem__title">Problem</h2>
          {problemHtml && <div class="problem__statement" set:html={problemHtml} />}
          {data.problemUrl && (
            <p class="problem__link">
              <a href={data.problemUrl} target="_blank" rel="noopener noreferrer">
                View original challenge ↗
              </a>
            </p>
          )}
          {data.hints.length > 0 && (
            <div class="problem__hints">
              {data.hints.map((_hint: string, i: number) => (
                <details class="hint">
                  <summary>Hint {i + 1}</summary>
                  <div class="hint__body" set:html={hintsHtml[i]} />
                </details>
              ))}
            </div>
          )}
        </section>
      )
    }

    <div class:list={['post-body', showToc && 'post-body--with-toc']}>
      {
        showToc && (
          <details class="toc" open>
            <summary>Contents</summary>
            <nav aria-label="Table of contents">
              <ul>
                {toc.map((h) => (
                  <li class="toc__item" data-level={h.level} style={`--lvl:${h.level}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
      <div class="post-body__main">
        <div class="prose">
          <slot />
        </div>

    {
      isCtf && data.flag && (
        <details class="flag">
          <summary>reveal flag</summary>
          <div class="flag__value">{data.flag}</div>
        </details>
      )
    }

    {
      data.tags && data.tags.length > 0 && (
        <ul class="tags" style="margin-top:2rem">
          {data.tags.map((t: string) => (
            <li><a class="tag" href={`/tags/${t}`}>{t}</a></li>
          ))}
        </ul>
      )
    }

    <nav class="post-foot" aria-label="Post navigation">
      <span>
        {older && <a href={`/${section}/${older.id}`}>&larr; {older.data.title}</a>}
      </span>
      <span>
        {newer && <a href={`/${section}/${newer.id}`}>{newer.data.title} &rarr;</a>}
      </span>
    </nav>
      </div>
    </div>
  </article>
</BaseLayout>

{
  showToc && (
    <script>
      // Scroll-spy: highlight the ToC link for the section currently in view.
      // ponytail: rootMargin heuristic marks a heading "active" once it passes
      // ~30% down the viewport; good enough, no per-pixel tracking needed.
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((a) => {
        links.set(decodeURIComponent(a.hash.slice(1)), a);
      });
      const targets = [...links.keys()]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      if (targets.length) {
        let current: string | null = null;
        const setActive = (id: string) => {
          if (id === current) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(id)?.setAttribute('aria-current', 'true');
          current = id;
        };
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length) setActive(visible[0].target.id);
          },
          { rootMargin: '-72px 0px -70% 0px', threshold: 0 }
        );
        targets.forEach((t) => observer.observe(t));
      }

      // Collapse the ToC by default on mobile; reopen it when widening to desktop.
      const tocEl = document.querySelector<HTMLDetailsElement>('details.toc');
      if (tocEl) {
        const wide = window.matchMedia('(min-width: 900px)');
        if (!wide.matches) tocEl.open = false;
        wide.addEventListener('change', (e) => {
          if (e.matches) tocEl.open = true;
        });
      }
    </script>
  )
}
